{
  "name": "duri-date-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Durable place resolution API and board backend",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.cjs",
    "openapi": "npm run build && node scripts/export-openapi.cjs",
    "seed:demo": "npm run build && node scripts/seed-demo.cjs",
    "poc": "npm run build && node scripts/poc.cjs",
    "backup": "node scripts/backup.cjs",
    "providers:check": "npm run build && node scripts/check-providers.cjs",
    "probe:public": "npm run build && node scripts/probe-public-queries.cjs",
    "verify:production": "npm run build && node scripts/verify-production.cjs",
    "start:local": "npm run build && node scripts/start-local.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/swagger": "^11.2.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "dotenv": "17.4.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.0.0 <26"
  }
}
