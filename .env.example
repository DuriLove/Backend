NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
DATABASE_FILE=data/store.sqlite
# Optional one-time import into an EMPTY SQLite database. JSON is never modified.
LEGACY_DATA_FILE=data/store.json
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
WORKER_ENABLED=true
PLACE_LOOKUP_PROVIDER=source
KAKAO_REST_API_KEY=
# New applications use NAVER API HUB. Set legacy only for existing Developers keys.
NAVER_API_MODE=hub
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Enable ONLY after confirming this app's retention/use policy with the provider.
KAKAO_PLACE_STORAGE_APPROVED=false
KAKAO_REGION_STORAGE_APPROVED=false
NAVER_PLACE_STORAGE_APPROVED=false
NAVER_REGION_STORAGE_APPROVED=false
# Optional separate random token (>=32 chars) for /api/v1/operations/metrics
OPERATIONS_TOKEN=
